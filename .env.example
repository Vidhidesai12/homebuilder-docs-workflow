# Generate a unique random value locally; never commit your real key.
N8N_ENCRYPTION_KEY=replace-with-a-long-random-secret
# Limited documents role on the existing Project 1 PostgreSQL container.
# For Docker Compose, the API joins Project 1's existing Docker network.
DOCUMENTS_DATABASE_URL_DOCKER=postgresql://homebuilder_docs:replace-with-generated-password@db:5432/homebuilder_ops
# Local review credentials; replace both values. Never commit .env.
REVIEW_USERNAME=local_reviewer
REVIEW_PASSWORD=replace-with-a-strong-local-password
# Dedicated bearer credential used only by n8n reporting requests.
REPORT_API_TOKEN=replace-with-a-long-random-reporting-token
